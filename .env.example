# Скопируй в .env: cp .env.example .env, потом отредактируй.

# === Домен ===
# Поддомен, который ведёт на твой сервер (DuckDNS / свой домен).
# Сайт будет на https://${DOMAIN}, MC сервер — на ${DOMAIN}:25565 (или через SRV).
DOMAIN=mc.example.com

# === Сайт ===
PUBLIC_SERVER_NAME=Мой Майнкрафт сервер
PUBLIC_SERVER_ADDRESS=mc.example.com
PUBLIC_SITE_URL=https://mc.example.com
PUBLIC_DISCORD_URL=https://discord.gg/example

# Опрос статуса MC (внутри docker сети — оставь minecraft:25565)
MC_HOST=minecraft
MC_PORT=25565

# JWT — обязательно поменяй! Сгенерируй: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_USE_openssl_rand_base64_48

# === Minecraft ===
MC_VERSION=1.21.1
MC_MEM=4G

# === Stripe (опционально) ===
# Если пусто — кнопка «Поддержать» покажет страницу-заглушку.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_5=
STRIPE_PRICE_ID_10=
STRIPE_PRICE_ID_25=
