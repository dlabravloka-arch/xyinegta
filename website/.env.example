# Скопируй в .env и заполни

# Адрес и порт твоего Minecraft сервера для опроса статуса
MC_HOST=mc.example.com
MC_PORT=25565

# Название сервера, которое видит пользователь на сайте
PUBLIC_SERVER_NAME=Мой Майнкрафт сервер
PUBLIC_SERVER_ADDRESS=mc.example.com

# Discord (опционально)
PUBLIC_DISCORD_URL=

# JWT секрет для сессий — обязательно поменяй на длинную случайную строку
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars

# Prisma SQLite — для production используй ../data/website.db (volume в docker)
DATABASE_URL="file:./dev.db"

# Stripe (донат) — оставь пустым если ещё не настроил, кнопка отдаст 503
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_5=
STRIPE_PRICE_ID_10=
STRIPE_PRICE_ID_25=
PUBLIC_SITE_URL=http://localhost:3000
